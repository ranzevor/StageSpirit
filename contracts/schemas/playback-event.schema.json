{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "语音播放事实",
  "type": "object",
  "properties": {
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "playback_id": {
      "type": "string",
      "minLength": 1
    },
    "playback_generation": {
      "type": "integer",
      "minimum": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "text_revision": {
      "type": "integer",
      "minimum": 0
    },
    "text": {
      "type": "string"
    },
    "phase": {
      "enum": [
        "prepared",
        "started",
        "progress",
        "finished",
        "interrupted",
        "failed"
      ]
    },
    "clock": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "pcm"
            },
            "played_samples": {
              "type": "integer",
              "minimum": 0
            },
            "sample_rate": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "played_samples",
            "sample_rate"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "provider_timestamp"
            },
            "position_ms": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "position_ms"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "native_lifecycle"
            },
            "started_monotonic_ms": {
              "type": "number",
              "minimum": 0,
              "description": "实际播放启动的单调时钟读数，单位毫秒"
            },
            "clock_epoch": {
              "type": "string",
              "minLength": 1,
              "description": "单调时钟所属进程时钟代际"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "dependentRequired": {
            "started_monotonic_ms": [
              "clock_epoch"
            ],
            "clock_epoch": [
              "started_monotonic_ms"
            ]
          }
        }
      ]
    },
    "error": {
      "$ref": "common.schema.json#/$defs/Error"
    },
    "connection_id": {
      "type": "string",
      "minLength": 1
    },
    "data_generation": {
      "$ref": "common.schema.json#/$defs/DataGeneration"
    },
    "occurred_at": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    }
  },
  "required": [
    "operation_id",
    "connection_id",
    "playback_id",
    "playback_generation",
    "sequence",
    "text_revision",
    "text",
    "phase",
    "clock",
    "data_generation",
    "occurred_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "progress"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "clock": {
            "properties": {
              "kind": {
                "enum": [
                  "pcm",
                  "provider_timestamp"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "failed"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "required": [
          "error"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "started",
              "finished",
              "interrupted"
            ]
          },
          "clock": {
            "properties": {
              "kind": {
                "const": "native_lifecycle"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "phase",
          "clock"
        ]
      },
      "then": {
        "properties": {
          "clock": {
            "required": [
              "started_monotonic_ms",
              "clock_epoch"
            ]
          }
        }
      }
    }
  ]
}
