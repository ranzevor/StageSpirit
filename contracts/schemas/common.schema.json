{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "共享分页 操作与错误",
  "$defs": {
    "PageRequest": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        },
        "cursor": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Page": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {},
          "maxItems": 200
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "has_more": {
          "type": "boolean"
        },
        "total_count": {
          "type": "integer",
          "minimum": 0
        },
        "metadata": {
          "type": "object"
        },
        "data_generation": {
          "$ref": "#/$defs/DataGeneration"
        }
      },
      "required": [
        "items",
        "next_cursor",
        "has_more",
        "data_generation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "has_more": {
                "const": true
              }
            },
            "required": [
              "has_more"
            ]
          },
          "then": {
            "properties": {
              "next_cursor": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "has_more": {
                "const": false
              }
            },
            "required": [
              "has_more"
            ]
          },
          "then": {
            "properties": {
              "next_cursor": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "OperationReceipt": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "accepted",
            "queued",
            "running",
            "cancel_requested",
            "completed",
            "cancelled",
            "failed",
            "outcome_unknown"
          ]
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error": {
          "$ref": "#/$defs/Error"
        },
        "data_generation": {
          "$ref": "#/$defs/DataGeneration"
        }
      },
      "required": [
        "operation_id",
        "state",
        "data_generation"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "description": "DATA_GENERATION_CHANGED表示数据代际已更换；HISTORY_GAP表示请求水位已不在可用历史范围"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "details_resource_id": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "object",
          "properties": {
            "current_data_generation": {
              "$ref": "#/$defs/DataGeneration"
            },
            "earliest_available_sequence": {
              "type": "integer",
              "minimum": 1
            },
            "requested_after_sequence": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    },
    "Value": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "amount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            "unit": {
              "const": "currency"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          "required": [
            "amount",
            "unit",
            "currency"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "amount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            "unit": {
              "enum": [
                "bits",
                "gold_coin",
                "silver_coin"
              ]
            }
          },
          "required": [
            "amount",
            "unit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "amount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            "unit": {
              "const": "platform_unit"
            },
            "unit_name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "amount",
            "unit",
            "unit_name"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "ResourceReceipt": {
      "type": "object",
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "data_generation": {
          "$ref": "#/$defs/DataGeneration"
        }
      },
      "required": [
        "resource_id",
        "uri",
        "media_type",
        "size_bytes",
        "data_generation"
      ],
      "additionalProperties": false
    },
    "DataGeneration": {
      "type": "string",
      "minLength": 1,
      "description": "运行配置的不透明数据代际，数据恢复后更换"
    }
  }
}
