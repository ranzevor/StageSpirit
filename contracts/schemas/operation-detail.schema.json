{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "操作效果与恢复详情",
  "type": "object",
  "properties": {
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "$ref": "common.schema.json#/$defs/OperationReceipt/properties/state"
    },
    "execution_generation": {
      "type": "integer",
      "minimum": 1
    },
    "effect_state": {
      "enum": [
        "none",
        "confirmed",
        "partial",
        "unknown"
      ]
    },
    "recovery": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "idle",
            "needed",
            "running",
            "resolved",
            "conflict"
          ]
        },
        "details_resource_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false
    },
    "result_resource_id": {
      "type": "string",
      "minLength": 1
    },
    "error": {
      "$ref": "common.schema.json#/$defs/Error"
    },
    "data_generation": {
      "$ref": "common.schema.json#/$defs/DataGeneration"
    }
  },
  "required": [
    "operation_id",
    "state",
    "execution_generation",
    "effect_state",
    "recovery",
    "data_generation"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "outcome_unknown"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "effect_state": {
            "const": "unknown"
          },
          "recovery": {
            "properties": {
              "state": {
                "enum": [
                  "needed",
                  "running"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "completed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "effect_state": {
            "enum": [
              "none",
              "confirmed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "failed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "error"
        ]
      }
    }
  ]
}
