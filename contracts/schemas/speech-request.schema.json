{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "普通语音播放请求",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "voice_id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "text_mode": {
      "enum": [
        "spoken",
        "verbatim"
      ],
      "default": "spoken"
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9,
      "default": 5,
      "description": "数值大者先播放，同级按持久 enqueue_sequence 先进先出；仅影响尚未取得播放权的任务。"
    },
    "interrupt_current": {
      "type": "boolean",
      "default": false,
      "description": "受理后请求当前播放停止，并保留下一播放权；旧播放停止且设备和控制释放后启动。同槽位已有打断切换时返回 PLAYBACK_SWITCH_BUSY。"
    },
    "style": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "connection_id": {
      "type": "string",
      "minLength": 1,
      "description": "省略时使用当前运行配置的默认语音连接"
    },
    "data_generation": {
      "$ref": "common.schema.json#/$defs/DataGeneration"
    }
  },
  "required": [
    "text",
    "idempotency_key",
    "data_generation"
  ],
  "additionalProperties": false
}
