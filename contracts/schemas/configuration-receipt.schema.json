{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "持久配置与活动修订回执",
  "type": "object",
  "properties": {
    "section": {
      "type": "string",
      "minLength": 1
    },
    "scope_id": {
      "type": "string",
      "minLength": 1
    },
    "saved_revision": {
      "type": "integer",
      "minimum": 0
    },
    "active_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "application_state": {
      "enum": [
        "applied",
        "applying",
        "failed"
      ]
    },
    "apply_operation_id": {
      "type": "string",
      "minLength": 1
    },
    "error": {
      "$ref": "common.schema.json#/$defs/Error"
    },
    "data_generation": {
      "$ref": "common.schema.json#/$defs/DataGeneration"
    }
  },
  "required": [
    "section",
    "saved_revision",
    "active_revision",
    "application_state",
    "data_generation"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "application_state": {
            "const": "failed"
          }
        },
        "required": [
          "application_state"
        ]
      },
      "then": {
        "required": [
          "error"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "application_state": {
            "const": "applied"
          }
        },
        "required": [
          "application_state"
        ]
      },
      "then": {
        "properties": {
          "active_revision": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "application_state": {
            "const": "applying"
          }
        },
        "required": [
          "application_state"
        ]
      },
      "then": {
        "required": [
          "apply_operation_id"
        ]
      }
    }
  ]
}
