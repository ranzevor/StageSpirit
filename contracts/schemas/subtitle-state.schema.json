{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "字幕显示视图",
  "type": "object",
  "properties": {
    "widget_id": {
      "type": "string",
      "minLength": 1
    },
    "playback_id": {
      "type": "string",
      "minLength": 1
    },
    "playback_generation": {
      "type": "integer",
      "minimum": 1
    },
    "text_revision": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "enum": [
        "showing",
        "hidden"
      ]
    },
    "text": {
      "type": "string",
      "pattern": "^[^\\[\\]]*$"
    },
    "data_generation": {
      "$ref": "common.schema.json#/$defs/DataGeneration"
    },
    "state_sequence": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "widget_id",
    "state",
    "text",
    "data_generation",
    "state_sequence"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "hidden"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "text": {
            "const": ""
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "showing"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "playback_id",
          "playback_generation",
          "text_revision"
        ]
      }
    }
  ],
  "dependentRequired": {
    "playback_id": [
      "playback_generation",
      "text_revision"
    ],
    "playback_generation": [
      "playback_id",
      "text_revision"
    ],
    "text_revision": [
      "playback_id",
      "playback_generation"
    ]
  }
}
