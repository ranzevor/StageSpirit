{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "语义调度状态摘要",
  "type": "object",
  "properties": {
    "data_generation": {
      "$ref": "common.schema.json#/$defs/DataGeneration"
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "description": "StageSpirit internal model identity, unique within the profile and bound to connection_id and provider_model_id"
    },
    "connection_id": {
      "type": "string",
      "minLength": 1
    },
    "model_generation": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "saved_revision": {
      "type": "integer",
      "minimum": 0
    },
    "active_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "state": {
      "enum": [
        "idle",
        "active",
        "suspended"
      ]
    },
    "playback": {
      "$ref": "#/$defs/PlaybackStatus"
    },
    "connection_generation": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "当前VTS连接代际，尚未连接时可为null"
    },
    "active_intent_count": {
      "type": "integer",
      "minimum": 0
    },
    "skipped_intent_count": {
      "type": "integer",
      "minimum": 0
    },
    "suspension_reason": {
      "$ref": "common.schema.json#/$defs/Error",
      "required": [
        "action"
      ]
    }
  },
  "required": [
    "data_generation",
    "model_id",
    "connection_id",
    "model_generation",
    "enabled",
    "saved_revision",
    "active_revision",
    "state",
    "connection_generation",
    "active_intent_count",
    "skipped_intent_count"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "active",
              "suspended"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "playback"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "suspended"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "suspension_reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "active"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "enabled": {
            "const": true
          },
          "active_revision": {
            "type": "integer",
            "minimum": 0
          },
          "model_generation": {
            "type": "integer",
            "minimum": 1
          },
          "connection_generation": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "PlaybackStatus": {
      "type": "object",
      "properties": {
        "playback_id": {
          "type": "string",
          "minLength": 1
        },
        "playback_generation": {
          "type": "integer",
          "minimum": 1
        },
        "text_revision": {
          "type": "integer",
          "minimum": 0
        },
        "speech_connection_id": {
          "type": "string",
          "minLength": 1
        },
        "playback_clock": {
          "enum": [
            "pcm",
            "provider_timestamp",
            "native_lifecycle"
          ]
        },
        "alignment_source": {
          "enum": [
            "provider_timestamp",
            "text_estimate"
          ],
          "description": "Text alignment source, independent from the audio playback clock"
        },
        "position_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "playback_id",
        "playback_generation",
        "text_revision",
        "speech_connection_id",
        "playback_clock",
        "alignment_source",
        "position_ms"
      ],
      "additionalProperties": false
    }
  }
}
