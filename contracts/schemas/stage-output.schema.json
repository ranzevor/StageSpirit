{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "展台输出与应用结果",
  "type": "object",
  "properties": {
    "data_generation": {
      "$ref": "common.schema.json#/$defs/DataGeneration"
    },
    "output_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "applied_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "实际生效修订，尚未成功应用时为null"
    },
    "connection_id": {
      "type": "string",
      "minLength": 1
    },
    "connection_generation": {
      "type": "integer",
      "minimum": 1
    },
    "target": {
      "$ref": "stage-preview.schema.json#/properties/target"
    },
    "state_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "lifecycle_state": {
      "enum": [
        "preparing",
        "active",
        "retained",
        "releasing",
        "released",
        "failed"
      ]
    },
    "ready": {
      "type": "boolean"
    },
    "painted": {
      "type": "boolean"
    },
    "output_url": {
      "type": "string",
      "format": "uri",
      "description": "Read-only URL restricted to this output and its resources"
    },
    "details_resource_id": {
      "type": "string",
      "minLength": 1,
      "description": "输出详情与引用分页入口资源，增长的引用集合在该资源指示的分页入口读取"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "description": "输出所属运行配置，绑定准备时的当前配置"
    },
    "target_id": {
      "type": "string",
      "minLength": 1,
      "description": "规范化实际OBS目标身份，连接别名和重连不改变该身份"
    },
    "output_slot_id": {
      "type": "string",
      "minLength": 1,
      "description": "由profile_id、project_id、target_id及场景原生身份确定的稳定槽位身份"
    },
    "replaces_output_id": {
      "type": "string",
      "minLength": 1,
      "description": "本输出成功接管时退出活动槽位的旧输出；无替换时省略"
    },
    "retained_reference_count": {
      "type": "integer",
      "minimum": 1,
      "description": "retained输出仍被计划外引用的数量，引用归零时转入释放流程"
    }
  },
  "required": [
    "data_generation",
    "output_id",
    "project_id",
    "applied_revision",
    "connection_id",
    "connection_generation",
    "target",
    "state_sequence",
    "lifecycle_state",
    "ready",
    "painted",
    "profile_id",
    "target_id",
    "output_slot_id"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle_state": {
            "enum": [
              "active",
              "retained"
            ]
          }
        },
        "required": [
          "lifecycle_state"
        ]
      },
      "then": {
        "required": [
          "output_url"
        ],
        "properties": {
          "applied_revision": {
            "type": "integer",
            "minimum": 0
          },
          "ready": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_state": {
            "const": "released"
          }
        },
        "required": [
          "lifecycle_state"
        ]
      },
      "then": {
        "properties": {
          "output_url": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "painted": {
            "const": true
          }
        },
        "required": [
          "painted"
        ]
      },
      "then": {
        "properties": {
          "ready": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_state": {
            "const": "preparing"
          }
        },
        "required": [
          "lifecycle_state"
        ]
      },
      "then": {
        "properties": {
          "applied_revision": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_state": {
            "const": "retained"
          }
        },
        "required": [
          "lifecycle_state"
        ]
      },
      "then": {
        "required": [
          "retained_reference_count",
          "details_resource_id"
        ]
      },
      "else": {
        "properties": {
          "retained_reference_count": false
        }
      }
    }
  ],
  "$defs": {
    "StageApplyResult": {
      "type": "object",
      "properties": {
        "data_generation": {
          "$ref": "common.schema.json#/$defs/DataGeneration"
        },
        "output_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "applied_revision": {
          "type": "integer",
          "minimum": 0
        },
        "connection_id": {
          "type": "string",
          "minLength": 1
        },
        "connection_generation": {
          "type": "integer",
          "minimum": 1
        },
        "target": {
          "$ref": "stage-preview.schema.json#/properties/target"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "description": "输出所属运行配置，绑定准备时的当前配置"
        },
        "target_id": {
          "type": "string",
          "minLength": 1,
          "description": "规范化实际OBS目标身份，连接别名和重连不改变该身份"
        },
        "output_slot_id": {
          "type": "string",
          "minLength": 1,
          "description": "由profile_id、project_id、target_id及场景原生身份确定的稳定槽位身份"
        },
        "replaces_output_id": {
          "type": "string",
          "minLength": 1,
          "description": "本输出成功接管时退出活动槽位的旧输出；无替换时省略"
        }
      },
      "required": [
        "data_generation",
        "output_id",
        "project_id",
        "applied_revision",
        "connection_id",
        "connection_generation",
        "target",
        "operation_id",
        "profile_id",
        "target_id",
        "output_slot_id"
      ],
      "additionalProperties": false
    },
    "StageOutputRelease": {
      "type": "object",
      "properties": {
        "data_generation": {
          "$ref": "common.schema.json#/$defs/DataGeneration"
        },
        "output_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_state_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "data_generation",
        "output_id",
        "expected_state_sequence",
        "idempotency_key"
      ],
      "additionalProperties": false
    }
  }
}
